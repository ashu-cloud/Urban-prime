# Global Environment Settings
ENVIRONMENT=local
LOG_LEVEL=debug

# Databases (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cab_user
POSTGRES_PASSWORD=cab_password
POSTGRES_DB=cab_booking_db

# Redis Geo & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Event Streaming
KAFKA_BROKERS=localhost:9092

# Centrifugo WebSockets
CENTRIFUGO_HTTP_HOST=http://localhost:8000
CENTRIFUGO_API_KEY=my_secret_api_key
CENTRIFUGO_SECRET=my_secret_token_hmac_key

# APISIX Gateway
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

# JWT Settings
JWT_SECRET=super_secret_jwt_signing_key_change_in_production
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# OSRM Routing Engine
OSRM_HOST=http://router.project-osrm.org

# Stripe Payments (Test Mode)
STRIPE_SECRET_KEY=sk_test_mock_key_for_development

# OpenTelemetry / Jaeger Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Microservices Internal Ports
AUTH_SERVICE_HTTP_PORT=8080
AUTH_SERVICE_GRPC_PORT=50056
TRIP_SERVICE_PORT=50051
DRIVER_SERVICE_PORT=50052
LOCATION_SERVICE_PORT=50053
PAYMENT_SERVICE_PORT=50054
NOTIFICATION_SERVICE_PORT=50055
