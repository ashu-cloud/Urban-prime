# ==============================================================================
# UrbanPrime Environment Variables (.env.example)
# Copy this file to .env and fill in your values.
# ==============================================================================
COMPOSE_PROFILES=full

# ------------------------------------------------------------------------------
# 1. Primary Relational Database (PostgreSQL 16)
# Local: postgres://cab_user:cab_password@localhost:5432/cab_booking_db?sslmode=disable
# Cloud (Neon.tech): postgresql://neondb_owner:password@ep-xyz.neon.tech/neondb?sslmode=require
# ------------------------------------------------------------------------------
POSTGRES_USER=cab_user
POSTGRES_PASSWORD=cab_password
POSTGRES_DB=cab_booking_db
POSTGRES_DSN=postgres://cab_user:cab_password@localhost:5432/cab_booking_db?sslmode=disable
DATABASE_URL=postgres://cab_user:cab_password@localhost:5432/cab_booking_db?sslmode=disable

# ------------------------------------------------------------------------------
# 2. In-Memory & Geospatial Database (Redis 7)
# Local: redis:6379 (or localhost:6379)
# Cloud (Upstash): rediss://default:password@endpoint.upstash.io:6379
# ------------------------------------------------------------------------------
REDIS_ADDR=redis:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# 32+ character random string for signing HS256 JWT tokens
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_min_32_characters_long

# ------------------------------------------------------------------------------
# 4. Centrifugo Real-time WebSocket Gateway
# Used for real-time driver tracking and live trip updates
# ------------------------------------------------------------------------------
CENTRIFUGO_API_KEY=your_centrifugo_api_key_here
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=your_centrifugo_hmac_secret_here
CENTRIFUGO_ADMIN_PASSWORD=admin
CENTRIFUGO_ADMIN_SECRET=your_centrifugo_admin_secret_here

# ------------------------------------------------------------------------------
# 5. Apache APISIX Gateway
# Admin key for managing APISIX routing configuration
# ------------------------------------------------------------------------------
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

# ------------------------------------------------------------------------------
# 6. Third-Party APIs
# Mapbox public access token (get free from https://mapbox.com)
# Stripe secret test key (get free test key from https://dashboard.stripe.com/test/apikeys)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
STRIPE_SECRET_KEY=sk_test_...

# ------------------------------------------------------------------------------
# 7. Frontend Endpoints (Baked into Next.js at build time)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:9080
NEXT_PUBLIC_CENTRIFUGO_WS=ws://localhost:8000/connection/websocket
